DJANGO_DEBUG=1
DJANGO_SECRET_KEY=...
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://user:password@localhost:5432/db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

OPENAI_API_KEY=...
OPENAI_RESPONSES_MODEL=gpt-5-nano
OPENAI_RESPONSES_TIMEOUT_SECONDS=30
OPENAI_RESPONSES_MAX_INSTRUCTION_CHARS=4000
# Optional overrides:
# OPENAI_RESPONSES_MAX_INPUT_TOKENS=400000
# OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=1200
# OPENAI_RESPONSES_REASONING_EFFORT=low
PERPLEXITY_API_KEY=...

FRONTEND_BASE_URL=http://newsradar.app/
DEFAULT_FROM_EMAIL=no-reply@newsradar.local

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...
STRIPE_CHECKOUT_SUCCESS_URL=http://newsradar.app/upgrade?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://newsradar.app/upgrade?checkout=cancelled
